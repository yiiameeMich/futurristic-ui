{
  "name": "@yiiameemich/futurristic-ui",
  "version": "0.1.0",
  "description": "Nuxt UI Kit module with defend / guard / expert color modes",
  "repository": "yiiameeMich/futurristic-ui",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./runtime/types/icon": {
      "types": "./dist/runtime/types/icon.d.ts",
      "import": "./dist/runtime/types/icon.mjs"
    },
    "./tailwind-preset": "./tailwind-preset.cjs"
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "runtime/types/icon": [
        "./dist/runtime/types/icon.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "scripts",
    "tailwind-preset.cjs"
  ],
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "postinstall": "node scripts/generate-fu-icon-types.mjs",
    "prepack": "node scripts/generate-fu-icon-types.mjs && nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "node scripts/generate-fu-icon-types.mjs && nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^3.0.0 || ^4.0.0",
    "defu": "^6.1.4",
    "vite-svg-loader": "^5.1.0"
  },
  "peerDependencies": {
    "nuxt": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.2.4",
    "@nuxt/eslint-config": "^1.15.2",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^3.0.0 || ^4.0.0",
    "@nuxt/test-utils": "^4.0.2",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "eslint": "^10.2.1",
    "nuxt": "^4.4.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.2.7"
  }
}
